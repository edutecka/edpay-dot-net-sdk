<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net7.0;netstandard2.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <PackageId>EDPay.Sdk</PackageId>
    <Version>1.0.0</Version>
    <Authors>EDPay Engineering</Authors>
    <Company>EDPay</Company>
    <Description>SDK Oficial EDPay para .NET (C#, ASP.NET Core, Blazor, MAUI)</Description>
    <PackageProjectUrl>https://github.com/edutecka/edpay-dot-net-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/edutecka/edpay-dot-net-sdk</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
